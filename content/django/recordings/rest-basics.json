{
  "kind": "http",
  "title": "A books resource, one request at a time",
  "steps": [
    {
      "label": "List",
      "note": "GET on the collection URL reads every book. Safe: it changes nothing.",
      "request": {
        "method": "GET",
        "url": "/api/books/",
        "headers": {},
        "body": null
      },
      "response": {
        "status": 200,
        "reason": "OK",
        "headers": {
          "Content-Type": "application/json"
        },
        "body": "{\n  \"results\": [\n    {\n      \"id\": 1,\n      \"title\": \"Dune\",\n      \"year\": 1965\n    }\n  ]\n}",
        "size": 55
      }
    },
    {
      "label": "Create",
      "note": "POST to the collection creates a new book. 201 Created, and Location says where the new resource lives.",
      "request": {
        "method": "POST",
        "url": "/api/books/",
        "headers": {
          "Content-Type": "application/json"
        },
        "body": "{\n  \"title\": \"Emma\",\n  \"year\": 1815\n}"
      },
      "response": {
        "status": 201,
        "reason": "Created",
        "headers": {
          "Content-Type": "application/json",
          "Location": "/api/books/2/"
        },
        "body": "{\n  \"id\": 2,\n  \"title\": \"Emma\",\n  \"year\": 1815\n}",
        "size": 40
      }
    },
    {
      "label": "Read one",
      "note": "GET on an item URL reads one resource, identified by its id in the path.",
      "request": {
        "method": "GET",
        "url": "/api/books/2/",
        "headers": {},
        "body": null
      },
      "response": {
        "status": 200,
        "reason": "OK",
        "headers": {
          "Content-Type": "application/json"
        },
        "body": "{\n  \"id\": 2,\n  \"title\": \"Emma\",\n  \"year\": 1815\n}",
        "size": 40
      }
    },
    {
      "label": "Replace",
      "note": "PUT replaces the whole resource. Sending the same PUT twice leaves the same state: PUT is idempotent.",
      "request": {
        "method": "PUT",
        "url": "/api/books/2/",
        "headers": {
          "Content-Type": "application/json"
        },
        "body": "{\n  \"title\": \"Emma\",\n  \"year\": 1816\n}"
      },
      "response": {
        "status": 200,
        "reason": "OK",
        "headers": {
          "Content-Type": "application/json"
        },
        "body": "{\n  \"id\": 2,\n  \"title\": \"Emma\",\n  \"year\": 1816\n}",
        "size": 40
      }
    },
    {
      "label": "Delete",
      "note": "DELETE removes it. 204 No Content: success, nothing to send back.",
      "request": {
        "method": "DELETE",
        "url": "/api/books/2/",
        "headers": {},
        "body": null
      },
      "response": {
        "status": 204,
        "reason": "No Content",
        "headers": {},
        "body": "",
        "size": 0
      }
    },
    {
      "label": "Delete again",
      "note": "A second DELETE answers 404, but the server's state is the same as after the first: still no book 2. Idempotent means same effect, not same status code.",
      "request": {
        "method": "DELETE",
        "url": "/api/books/2/",
        "headers": {},
        "body": null
      },
      "response": {
        "status": 404,
        "reason": "Not Found",
        "headers": {
          "Content-Type": "application/json"
        },
        "body": "{\n  \"error\": \"Book 2 not found.\"\n}",
        "size": 30
      }
    },
    {
      "label": "Bad input",
      "note": "Invalid input is the client's fault: 400 Bad Request with a message saying what to fix.",
      "request": {
        "method": "POST",
        "url": "/api/books/",
        "headers": {
          "Content-Type": "application/json"
        },
        "body": "{\n  \"title\": \"No year\"\n}"
      },
      "response": {
        "status": 400,
        "reason": "Bad Request",
        "headers": {
          "Content-Type": "application/json"
        },
        "body": "{\n  \"error\": \"Send JSON with a title and a year.\"\n}",
        "size": 47
      }
    },
    {
      "label": "Wrong method",
      "note": "This resource doesn't support PATCH: 405 Method Not Allowed, and the Allow header lists what is allowed.",
      "request": {
        "method": "PATCH",
        "url": "/api/books/1/",
        "headers": {
          "Content-Type": "application/json"
        },
        "body": "{\n  \"year\": 1966\n}"
      },
      "response": {
        "status": 405,
        "reason": "Method Not Allowed",
        "headers": {
          "Allow": "GET, PUT, DELETE"
        },
        "body": "",
        "size": 0
      }
    }
  ]
}
