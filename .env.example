# Copy to .env.local (Next.js) — scripts also read it.
# Local Docker Postgres (see docker-compose.yml). For Neon, paste its pooled connection string here.
DATABASE_URL=postgres://neo:neo_local_dev@localhost:5434/neodevnotebook
# Used by unit tests that touch the DB. Never point this at real data.
TEST_DATABASE_URL=postgres://neo:neo_local_dev@localhost:5434/neodevnotebook_test
# Public site URL (used for metadata / sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
