# Copy to .env (never commit .env). These values are fakes for local development.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=fake-dev-key-change-me-0123456789abcdefghijklmnopqrstuvwxyz
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Signs JWTs; rotate it to log every API client out.
JWT_SIGNING_KEY=fake-jwt-key-change-me-abcdefghijklmnopqrstuvwxyz0123456789
JWT_ACCESS_MINUTES=5
JWT_REFRESH_DAYS=1
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@example.com
