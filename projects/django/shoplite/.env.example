# Copy to .env for local development (never commit .env). Every value here is a FAKE.
# The test suite always loads this file, so tests never depend on your real secrets.
DJANGO_SECRET_KEY=fake-dev-key-change-me-0123456789abcdefghijklmnopqrstuvwxyz
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=sqlite:///shoplite.sqlite3
# DATABASE_URL=postgres://shop:shop@localhost:5432/shoplite
CACHE_URL=locmemcache://
JWT_SIGNING_KEY=fake-jwt-key-change-me-abcdefghijklmnopqrstuvwxyz0123456789
JWT_ACCESS_MINUTES=10
JWT_REFRESH_DAYS=7
PAYMENTS_WEBHOOK_SECRET=whsec_fake_0123456789abcdefghijklmnopqrstuv
PAYMENTS_WEBHOOK_TOLERANCE_SECONDS=300
CORS_ALLOWED_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO
